extends TestCase
const View = preload("res://scenes/play/combat_view.gd")
func tick(f: Fighter,a: Dictionary,seconds: float) -> void:
	for i in int(seconds*60): f.update(1.0/60,a)
func test_combo_followthrough_interruption_and_directional_reactions() -> void:
	var f := Fighter.create({"race":"Saiyan"})
	f.update(1.0/60,{"attackSerial":1,"attackKind":"cross"})
	tick(f,{"attackSerial":1},0.15)
	ok(f.anim.mod.strike>0.4,"sharp extension after anticipation")
	f.presentation = {"hitWeight":1.0,"hitSide":-0.8,"reactionSerial":1}
	f.update(1.0/60,{"hurt":true,"attackSerial":1})
	eq(f.anim.one_shot,"Hit_Head")
	ok(f.anim.mod.heavy_hit>0.9)
	near(f.anim.mod.hit_side,-0.8)
	f.presentation.reactionSerial = 2
	f.update(1.0/60,{"hurt":true,"attackSerial":1})
	ok(f.anim.one_shot_left>0.1,"a second hit restarts reaction even inside hurt window")
	f.presentation.clear()
	tick(f,{"attackSerial":1},2)
	near(f.anim.mod.strike,0)
	ok(f.anim.mod.heavy_hit<0.001)
	f.free()
func test_landing_braking_turning_and_death_clear_layers() -> void:
	var f := Fighter.create({"race":"Human"})
	f.update(1.0/60,{"onGround":false,"vy":-12})
	f.update(1.0/60,{"onGround":true})
	ok(f.anim.mod.landing>0.7)
	tick(f,{"speed":10},0.3)
	f.rotation.y = 0.4
	f.update(1.0/60,{"speed":10})
	ok(absf(f.anim.mod.lean)>0.01)
	f.update(1.0/60,{"speed":0})
	ok(f.anim.mod.brake>0)
	f.update(1.0/60,{"attackSerial":1,"attackKind":"leg kick"})
	f.update(1.0/60,{"dead":true,"attackSerial":1})
	ok(not f.anim.kicking())
	near(f.anim.mod.kick,0)
	tick(f,{},2)
	ok(f.anim.mod.landing==0 and absf(f.anim.mod.lean)<0.001)
	f.free()
func test_charge_base_colour_beam_pitch_and_form_personality() -> void:
	var f := Fighter.create({"race":"Saiyan","kiColorHex":"#12abef"})
	var hair_rest: Transform3D = f.hair.transform
	tick(f,{"charging":true},0.1)
	ok(f.charge_aura!=null and f.charge_aura.visible)
	var small: float = f.charge_aura.scale.x
	tick(f,{"charging":true},1.5)
	ok(f.charge_aura.scale.x>small)
	eq(int(f.charge_aura.look.color),0x12abef)
	tick(f,{},1.0)
	ok(f.hair.transform.is_equal_approx(hair_rest),"secondary motion preserves bone attachment rest transform")
	f.presentation = {"beamCharge":1.0,"aimPitch":0.7}
	tick(f,{},0.4)
	ok(f.anim.mod.cast>0.95 and f.anim.mod.aim_pitch>0.6)
	f.set_form("UIPerfected")
	eq(f.anim.style.calm,1.0)
	f.set_form("UltraEgo")
	eq(f.anim.style.aggression,1.0)
	f.update(1.0/60,{})
	ok(f.anim.mod.surge_weight>0)
	f.set_form("LegendarySSJ")
	ok(f.anim.style.weight>1)
	f.set_form("")
	eq(f.anim.style.weight,1.0)
	f.free()
func test_audio_clips_loop_cache_and_flourish_lifetime() -> void:
	for kind: String in ["hit","guard","whoosh","beam","surge","charge"]:
		var sound := CombatAudio.clip(kind)
		ok(sound.data.size()>1000)
		ok(sound==CombatAudio.clip(kind),"sample reused")
	eq(CombatAudio.clip("charge").loop_mode,AudioStreamWAV.LOOP_FORWARD)
	var fx := CombatFlourish.create("arc",Color.CYAN)
	fx.tick(0.1)
	ok(fx.material.albedo_color.a>0 and fx.material.albedo_color.a<0.8)
	fx.free()
func test_combat_events_drive_visuals_without_changing_damage_or_state() -> void:
	var slot: Dictionary = RuleSchema.new().new_slot(RuleSchema.new().default_look("Saiyan"))
	var g := RuleGame.new(0,slot,Events)
	var root := Node3D.new()
	var f := Fighter.create({"race":"Saiyan"}); f.name = "Player"; root.add_child(f)
	var camera := Camera3D.new(); root.add_child(camera)
	var v := View.new(g.combat,camera); root.add_child(v)
	g.player.attackSerial = 1; g.player.attackKind = "hook"
	var hp: float = g.player.health
	Events.attack.emit({"id":"player","kind":"melee","pos":g.player.pos})
	eq(f.presentation.attackKind,"hook","event reaches fighter before its next animation update")
	v.update_view(1.0/60)
	eq(f.presentation.attackKind,"hook")
	Events.damage.emit({"id":"player","amount":10,"pos":g.player.pos,"blocked":false})
	v.update_view(1.0/60)
	ok(f.presentation.has("reactionSerial"))
	near(g.player.health,hp,0.0001,"visual events cannot damage the player")
	for i in 40: v._flourish("arc",Vector3.ZERO,Color.WHITE)
	ok(v.flourish_root.get_child_count()<=24)
	g.player.attackSerial = 2
	Events.attack.emit({"id":"player","kind":"beam","pos":g.player.pos})
	f.update(1.0/60,{"attackSerial":2,"attackKind":"cross"})
	eq(f.anim.mod.strike_kind,"beam","skill casting replaces generic cross on first frame")
	g.player.attackSerial = 3
	v.update_view(1.0/60)
	ok(not f.presentation.has("attackKind"),"pose override ends when next attack arrives")
	# _exit_tree is not called for unattached nodes; disconnect test-only view explicitly.
	v._exit_tree()
	root.free()
