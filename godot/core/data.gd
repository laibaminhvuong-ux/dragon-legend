extends Node
# Autoload "Data": the game's tables, generated by tools/export_godot_data.mjs into res://data/<name>.json.
# Each file becomes the property of the same name. A missing table stays empty; a broken file is reported
# in `errors` (and as a warning) instead of stopping the game.

var quests: Array = []
var npcs: Array = []
var characters: Dictionary = {}
var links: Dictionary = {}
var forms: Dictionary = {}
var mastery_evolutions: Array = []
var moves: Dictionary = {}
var races: Dictionary = {}
var outfits: Dictionary = {}
var accessories: Dictionary = {}
var zones: Dictionary = {}
var stats: Dictionary = {}
var combat: Dictionary = {}
var movement: Dictionary = {}
var camera: Dictionary = {}
var cutscenes: Dictionary = {}
var form_looks: Dictionary = {}
var dragon_hunts: Variant = []
var kaioken: Dictionary = {}
var avatar: Dictionary = {}
var rpg: Dictionary = {}
var appearance: Dictionary = {}

var errors: Array[String] = []
var _extra: Dictionary = {}  # files that aren't one of the named tables

func _ready() -> void:
	load_dir("res://data")

func load_dir(path: String) -> void:
	errors.clear()
	var d := DirAccess.open(path)
	if d == null:
		return
	for f in d.get_files():
		if not f.ends_with(".json"):
			continue
		var text := FileAccess.get_file_as_string(path.path_join(f))
		var json := JSON.new()
		if json.parse(text) != OK:
			var msg := "%s: %s (line %d)" % [f, json.get_error_message(), json.get_error_line()]
			errors.append(msg)
			push_warning("Data: could not read " + msg)
			continue
		var name := f.get_basename()
		if name in self and _is_table(name):
			set(name, json.data)
		else:
			_extra[name] = json.data

func table(name: String) -> Variant:
	if _is_table(name):
		return get(name)
	if _extra.has(name):
		return _extra[name]
	push_warning("Data: no table named '%s'" % name)
	return null

func _is_table(name: String) -> bool:
	return name not in ["errors", "_extra"] and name in self and not name.begins_with("_")
