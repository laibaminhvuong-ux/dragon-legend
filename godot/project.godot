; The Dragon Legend: Godot version (see docs/superpowers/specs/2026-11-02-godot-port-design.md)
config_version=5

[application]
config/name="The Dragon Legend"
config/version="0.0.4"
; exported builds keep saves in %APPDATA%/DragonLegend (editor and test runs keep theirs apart)
config/use_custom_user_dir.template=true
config/custom_user_dir_name.template="DragonLegend"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[debug]
gdscript/warnings/inference_on_variant=2

[display]
window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="forward_plus"
environment/ssao/quality=1
environment/ssao/half_size=true
environment/ssil/half_size=true

[audio]

general/text_to_speech=true

[autoload]

Updater="*res://core/updater.gd"
Data="*res://core/data.gd"
Events="*res://core/events.gd"
SaveStore="*res://core/save_store.gd"
Clock="*res://core/clock.gd"
Controls="*res://core/controls.gd"
Settings="*res://core/settings.gd"
Voices="*res://core/voices.gd"
Music="*res://core/music.gd"
