{
  "folders": [
    {
      "name": "dragon ball project",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.godot": true,
      "**/node_modules": true
    },
    "search.exclude": {
      "**/.godot": true,
      "**/node_modules": true,
      "release/**": true,
      "build/**": true
    },
    "terminal.integrated.cwd": "${workspaceFolder}"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Dragon Legend: headless tests + data check",
        "type": "process",
        "command": "bash",
        "args": [
          "tools/godot_test.sh",
          "--check-data"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "problemMatcher": []
      },
      {
        "label": "Dragon Legend: verify generated data",
        "type": "process",
        "command": "node",
        "args": [
          "tools/export_godot_data.mjs",
          "--check"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      }
    ]
  }
}
