{
  "folders": [
    {
      "name": "dragon ball project",
      "path": "\\\\wsl.localhost\\Ubuntu\\home\\laptop_usd\\dragon-ball"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.godot": true,
      "**/node_modules": true
    },
    "search.exclude": {
      "**/.godot": true,
      "**/node_modules": true,
      "release/**": true,
      "build/**": true
    },
    "terminal.integrated.cwd": "${workspaceFolder}"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Dragon Legend: headless tests + data check",
        "type": "process",
        "command": "bash",
        "args": [
          "tools/godot_test.sh",
          "--check-data"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "problemMatcher": [],
        "windows": {
          "command": "wsl.exe",
          "args": [
            "-d",
            "Ubuntu",
            "--cd",
            "/home/laptop_usd/dragon-ball",
            "bash",
            "tools/godot_test.sh",
            "--check-data"
          ]
        }
      },
      {
        "label": "Dragon Legend: verify generated data",
        "type": "process",
        "command": "node",
        "args": [
          "tools/export_godot_data.mjs",
          "--check"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "windows": {
          "command": "wsl.exe",
          "args": [
            "-d",
            "Ubuntu",
            "--cd",
            "/home/laptop_usd/dragon-ball",
            "node",
            "tools/export_godot_data.mjs",
            "--check"
          ]
        }
      }
    ]
  }
}
